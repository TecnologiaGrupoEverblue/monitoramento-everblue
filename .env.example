# =============================================================================
# Monitoramento Everblue — modelo de configuração do servidor
# =============================================================================
# `./infrastructure/scripts/preparar.sh` copia este arquivo para `.env` e
# preenche os segredos com valores aleatórios gerados NO SERVIDOR.
# O `.env` nunca é versionado, nunca entra em imagem e fica com permissão 600.
# Valores com espaço vão entre aspas.

# -----------------------------------------------------------------------------
# Ambiente
# -----------------------------------------------------------------------------
AMBIENTE=producao
TZ=America/Sao_Paulo
NIVEL_LOG=info
# Endereço público (https). Dele sai o endereço de retorno do login:
# URL_PUBLICA + /oauth/oidc/callback — exatamente o registrado no Entra ID.
URL_PUBLICA=https://monitoramento.grupoeverblue.com.br
COOKIE_SEGURO=true
PORTA_HTTP=80
PORTA_HTTPS=443

# Disco de dados da VM (bind mounts do PostgreSQL e do MinIO).
DADOS_DIR=/opt/everblue-monitoramento/dados

# -----------------------------------------------------------------------------
# PostgreSQL 16
# -----------------------------------------------------------------------------
# Superusuário: só administração (psql, verificação). A aplicação NÃO o usa.
POSTGRES_DB=monitoramento
POSTGRES_USER=emon_admin
POSTGRES_PASSWORD=TROQUE_gerado_pelo_preparar
# Papel da aplicação: dono do banco, sem superusuário. Criado na primeira
# inicialização do volume (database/init/01_papel_aplicacao.sh).
POSTGRES_APP_USER=emon_app
POSTGRES_APP_PASSWORD=TROQUE_gerado_pelo_preparar
DATABASE_URL=postgresql://emon_app:TROQUE@db:5432/monitoramento
DATABASE_POOL_MAX=10

# -----------------------------------------------------------------------------
# Sessão e cofre
# -----------------------------------------------------------------------------
SESSAO_SEGREDO=TROQUE_gerado_pelo_preparar
SESSAO_HORAS=8
# Semente da chave AES-256-GCM do cofre. Mantida por compatibilidade: desde a
# 1.0.2 nenhum token delegado é guardado.
COFRE_CHAVE=TROQUE_gerado_pelo_preparar

# -----------------------------------------------------------------------------
# Login corporativo — Microsoft Entra ID (MESMO modelo da IA Everblue)
# -----------------------------------------------------------------------------
# App Registration própria "Monitoramento Everblue" (plataforma Web):
#   - Redirect URI: https://monitoramento.grupoeverblue.com.br/oauth/oidc/callback
#   - Permissões delegadas padrão: openid, profile, email (QUEM é a pessoa)
#   - Microsoft Graph  User.Read.All (APLICAÇÃO, consentimento de administrador)
#       → nome, e-mail, cargo e foto
#   - Token configuration: claim "groups" = "Groups assigned to the application"
#   - Enterprise app: "Assignment required = Yes", com os grupos atribuídos
# NÃO é preciso expor a Intranet como API nem pedir `access_as_user`.
# Preenchido por: CONFIGURAR-LOGIN-ENTRA.cmd
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
# Vazio = URL_PUBLICA + /oauth/oidc/callback (recomendado).
ENTRA_REDIRECT_URI=
# Grupo do Entra (id, preferível ao nome) → perfil: leitor | analista | gestor | admin
#   ENTRA_MAPA_PERFIL=2b1f...=admin;7c3e...=gestor;9a0d...=analista
ENTRA_MAPA_PERFIL=
# Perfil de quem não cai em grupo mapeado. Mínimo: privilégio por omissão é
# como acesso indevido nasce.
ENTRA_PERFIL_PADRAO=leitor
ENTRA_TIMEOUT_S=15
# Nome, e-mail e cargo vêm da INTRANET (como na IA). true = o Graph (User.Read.All)
# só COMPLETA o que faltar; falha do Graph nunca bloqueia o login (1.0.4).
ENTRA_GRAPH_PERFIL=true

# -----------------------------------------------------------------------------
# Autorização de sistema — Intranet (GET /api/access/v1/me), por HMAC
# -----------------------------------------------------------------------------
# A Intranet decide QUEM entra e quem CONTINUA dentro (revalidação a cada 5 min,
# cache máximo do contrato). A chamada é ASSINADA entre servidores (Client ID,
# oid, horário, nonce) com uma chave EXCLUSIVA do Monitoramento, derivada na
# Intranet do segredo mestre dela. Nenhum token delegado é pedido ou guardado.
# Preenchido por: ATUALIZAR-E-CONECTAR-INTRANET.cmd (conectar_intranet.sh).
# Na Intranet › Configurações › Controle de Acessos: cadastrar o Application
# (client) ID do Monitoramento e LIBERAR as pessoas — sem isso ninguém entra.
DIRETORIO_URL=
# Application (client) ID DESTE Monitoramento. Vazio usa ENTRA_CLIENT_ID.
DIRETORIO_CLIENT_ID=
# Chave derivada exclusiva (43 caracteres). NÃO é o client secret do Entra.
DIRETORIO_INTEGRATION_SECRET=
DIRETORIO_TIMEOUT_S=20
# Minutos tolerados SEM conseguir reperguntar à Intranet. 0 = fail-closed.
DIRETORIO_GRACA_MINUTOS=0

# Foto do cartão do usuário: graph (User.Read.All) | intranet (/api/access/v1/photo, mesma assinatura) | nenhuma
FOTO_FONTE=graph

# E-mail que sempre recebe perfil admin ao entrar pelo Entra.
ADMIN_EMAIL=waldomiro.silva@grupoeverblue.com.br
LOGIN_MAX_TENTATIVAS=5
LOGIN_BLOQUEIO_MINUTOS=15

# -----------------------------------------------------------------------------
# MinIO — repositório central de TODOS os arquivos
# -----------------------------------------------------------------------------
# Importados, processados, exportados e anexos, com ciclo de vida completo:
# envio, versões, metadados, arquivamento, exclusão lógica, restauração e
# expurgo. NÃO é backup: o backup segue o processo corporativo.
#
# A MinIO deixou de publicar imagens da edição comunitária (out/2025): o
# MinIO é COMPILADO do código-fonte oficial no build (infrastructure/minio.Dockerfile).
# Versões fixadas por tag de release do GitHub (github.com/minio/minio e /mc).
# Build exige saída para github.com e proxy.golang.org.
MINIO_VERSAO=RELEASE.2025-10-15T17-29-55Z
MC_VERSAO=RELEASE.2025-08-13T08-35-41Z
# Credencial raiz: só o minio-init e a operação usam.
MINIO_ROOT_USER=emon-root
MINIO_ROOT_PASSWORD=TROQUE_gerado_pelo_preparar
# Credencial DA APLICAÇÃO: controle total do bucket da aplicação (s3:*),
# sem administração do servidor MinIO.
MINIO_ENDPOINT=http://minio:9000
MINIO_REGIAO=us-east-1
MINIO_BUCKET=everblue-monitoramento
MINIO_ACCESS_KEY=emon-app
MINIO_SECRET_KEY=TROQUE_gerado_pelo_preparar
# Object Lock (WORM) só pode ser ligado NA CRIAÇÃO do bucket. Desligado por
# padrão: com ele, objetos retidos não podem ser apagados nem pelo expurgo.
MINIO_OBJECT_LOCK=false

# Central de Arquivos: qualquer tipo de arquivo é aceito.
# Tamanho máximo por arquivo em MB (0 = sem limite; o arquivo passa em fluxo,
# sem ocupar memória — o limite real é o espaço do disco de dados).
ARQUIVOS_MAX_MB=0
# Extensões recusadas, se a política da companhia exigir (ex.: .exe,.bat). Vazio = nenhuma.
ARQUIVOS_EXTENSOES_BLOQUEADAS=

# -----------------------------------------------------------------------------
# Importação semanal
# -----------------------------------------------------------------------------
IMPORTACAO_MAX_MB=20
IMPORTACAO_MAX_LINHAS=20000

# -----------------------------------------------------------------------------
# Rede de saída (opcional) — proxy corporativo para Entra/Graph
# -----------------------------------------------------------------------------
# HTTPS_PROXY=http://proxy.grupoeverblue.local:3128
# NO_PROXY=localhost,127.0.0.1,db,minio,api
